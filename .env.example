# Copie para `.env` (raiz) e ajuste. Nunca versione `.env`. Nenhuma chave Binance é necessária:
# o MVP usa apenas dados públicos de mercado Spot.

# Frontend Next.js. O navegador chama /api/v1 na própria origem; o Next repassa para CLARITAS_API_URL
# (lado servidor, lida no build). Só o WebSocket vai direto à API (URL pública, com ticket de sessão).
CLARITAS_API_URL=http://localhost:4000
NEXT_PUBLIC_CLARITAS_WS_URL=ws://localhost:4000/api/v1/market/stream

# Backend Node/Fastify (services/api)
API_HOST=127.0.0.1
API_PORT=4000
# Lista separada por vírgula. Em produção use o domínio real — nunca `*`.
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
API_RATE_LIMIT_PER_MINUTE=600
# Autenticação (ADR-018): sessão de login, cookie Secure (padrão: só em produção), limite das rotas de senha
# e proxies confiáveis para o IP do cliente (false | true | número de saltos).
SESSION_TTL_DAYS=30
# SESSION_COOKIE_SECURE=true
AUTH_RATE_LIMIT_PER_MINUTE=20
TRUST_PROXY=false
MARKET_DATA_PROVIDER=binance_spot
BINANCE_SPOT_REST_URL=https://data-api.binance.vision
BINANCE_SPOT_WS_URL=wss://data-stream.binance.vision:443
BINANCE_HTTP_TIMEOUT_MS=4000
MARKET_DEFAULT_SYMBOL=BTCUSDT
MARKET_DEFAULT_INTERVAL=5m
MARKET_FEATURED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,LINKUSDT
STREAM_STALE_AFTER_MS=15000
STREAM_UPSTREAM_LINGER_MS=30000
STREAM_MAX_SUBSCRIPTIONS_PER_CLIENT=40
SCANNER_UNIVERSE_SIZE=30
SCANNER_CONCURRENCY=4

# Persistência (Etapas 8 e 10). Sem DATABASE_URL a API sobe, mas entrar/criar conta e toda rota com sessão respondem 503.
# Banco do projeto: PostgreSQL gerenciado (Neon). Use a connection string do painel do Neon (com sslmode=require).
DATABASE_URL=postgresql://USUARIO:SENHA@SEU-ENDPOINT.neon.tech/neondb?sslmode=require
# Testes de banco (npm run test:db) usam SEMPRE um PostgreSQL local isolado (npm run db:local:start), nunca o DATABASE_URL.
# DATABASE_URL_TEST_ADMIN=postgresql://claritas:claritas_dev@127.0.0.1:5544/postgres
