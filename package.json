{
  "name": "claritas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,api -c gray,yellow \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev",
    "dev:api": "npm run dev -w @claritas/api",
    "build": "next build",
    "build:api": "npm run build -w @claritas/api",
    "start": "next start",
    "start:api": "npm run start -w @claritas/api",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run --project contracts --project api --project web",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:db": "vitest run --project db",
    "db:local:start": "node scripts/db-local.mjs start",
    "db:local:stop": "node scripts/db-local.mjs stop",
    "db:migrate": "npm exec -w @claritas/api -- prisma migrate deploy",
    "db:seed": "npm exec -w @claritas/api -- prisma db seed",
    "db:generate": "npm exec -w @claritas/api -- prisma generate"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.1",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=24.11.0"
  }
}
