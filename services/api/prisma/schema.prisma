// Persistência de PRODUTO (não de cotações): contas, sessões, watchlist e preferências do terminal.
// Dono único das migrações: services/api. Ver docs/PERSISTENCE.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Conta de acesso ao terminal (e-mail + senha). A senha é guardada só como hash scrypt.
model User {
  id           String          @id @default(cuid())
  /// Sempre em minúsculas (normalizado pelo contrato).
  email        String          @unique
  name         String
  passwordHash String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     Session[]
  watchlist    Watchlist?
  preference   UserSettings?
}

/// Sessão de login. O token vai só no cookie do navegador; aqui fica apenas o SHA-256 dele.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Lista de ativos acompanhados. Uma por usuário; a lista sem dono chamada "default" é o modelo copiado
/// para contas novas (criada pelo seed).
model Watchlist {
  id        String          @id @default(cuid())
  name      String
  userId    String?         @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     WatchlistItem[]
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Item identificado de forma independente do provedor (base/cotação), não pelo símbolo da Binance.
model WatchlistItem {
  id          String    @id @default(cuid())
  watchlistId String
  baseAsset   String
  quoteAsset  String
  position    Int
  createdAt   DateTime  @default(now())
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, baseAsset, quoteAsset])
  @@index([watchlistId, position])
}

/// Preferências do terminal por usuário (último ativo, intervalo, leitura ligada).
model UserSettings {
  userId       String   @id
  symbol       String?
  interval     String?
  showAnalysis Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// LEGADO (até a autenticação, out/2026): preferências por cliente anônimo. Não é mais lida nem escrita;
/// mantida para não apagar dados numa migração. Remover só com decisão registrada (docs/DECISIONS.md).
model UserPreference {
  clientId     String   @id
  symbol       String?
  interval     String?
  showAnalysis Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
