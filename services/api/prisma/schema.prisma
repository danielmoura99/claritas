// Persistência de PRODUTO (não de cotações): watchlist e preferências do terminal.
// Dono único das migrações: services/api. Ver docs/PERSISTENCE.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Lista de ativos acompanhados. Sem autenticação nesta fase: existe a lista "default" compartilhada.
model Watchlist {
  id        String          @id @default(cuid())
  name      String          @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     WatchlistItem[]
}

/// Item identificado de forma independente do provedor (base/cotação), não pelo símbolo da Binance.
model WatchlistItem {
  id          String    @id @default(cuid())
  watchlistId String
  baseAsset   String
  quoteAsset  String
  position    Int
  createdAt   DateTime  @default(now())
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, baseAsset, quoteAsset])
  @@index([watchlistId, position])
}

/// Preferências do terminal por cliente anônimo (id opaco gerado no navegador). Não é conta de usuário.
model UserPreference {
  clientId     String   @id
  symbol       String?
  interval     String?
  showAnalysis Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
